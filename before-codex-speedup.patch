+% =====================================================================
+% Load fitted model OptoStim-90 minus OptoStim-0 response
+% =====================================================================
+
+function [differenceMap, modelInfo] = ...
+        demoLoadModelOptoDifference(modelResponseFile)
+
+    if exist(modelResponseFile, 'file') ~= 2
+        error( ...
+            'plotDemoOptostim:MissingModelResponseFile', ...
+            'Could not find model-response file: %s', ...
+            modelResponseFile);
+    end
+
+    loadedModel = load(modelResponseFile, 'Data');
