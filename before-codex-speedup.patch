+    if ~isfield(loadedModel, 'Data') || ...
+            ~isstruct(loadedModel.Data) || ...
+            ~isfield(loadedModel.Data, 'OptoStim') || ...
+            ~isstruct(loadedModel.Data.OptoStim) || ...
+            ~isfield(loadedModel.Data.OptoStim, 'Fit') || ...
+            ~iscell(loadedModel.Data.OptoStim.Fit) || ...
+            numel(loadedModel.Data.OptoStim.Fit) < 2
+
+        error( ...
+            'plotDemoOptostim:InvalidModelResponseStructure', ...
+            ['The model file must contain ' ...
+             'Data.OptoStim.Fit{1,1} and Fit{1,2}.']);
+    end
+
+    fit0 = loadedModel.Data.OptoStim.Fit{1,1};
+    fit90 = loadedModel.Data.OptoStim.Fit{1,2};
+
+    if ~isstruct(fit0) || ...
+            ~isfield(fit0, 'YFit') || ...
+            isempty(fit0.YFit) || ...
+            ~isstruct(fit90) || ...
+            ~isfield(fit90, 'YFit') || ...
+            isempty(fit90.YFit)
+
+        error( ...
+            'plotDemoOptostim:MissingModelYFit', ...
+            ['The model file does not contain valid YFit maps in ' ...
+             'Data.OptoStim.Fit{1,1} and Fit{1,2}.']);
+    end
+
+    response0 = double(fit0.YFit);
+    response90 = double(fit90.YFit);
+
+    if ~isequal(size(response0), size(response90))
+        error( ...
+            'plotDemoOptostim:ModelYFitSizeMismatch', ...
+            ['Model YFit maps have different sizes: [%s] and [%s].'], ...
+            num2str(size(response0)), ...
+            num2str(size(response90)));
+    end
+
+    if ~any(isfinite(response0(:))) || ...
+            ~any(isfinite(response90(:)))
+        error( ...
+            'plotDemoOptostim:EmptyModelYFit', ...
+            'One or both model YFit maps contain no finite pixels.');
+    end
+
+    differenceMap = response90 - response0;
+
+    modelInfo = struct();
+    modelInfo.file = modelResponseFile;
+    modelInfo.response0 = response0;
+    modelInfo.response90 = response90;
+    modelInfo.difference90Minus0 = differenceMap;
